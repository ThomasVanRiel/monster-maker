# Copy to .env on each machine (gitignored) and fill in.

# --- home server (compose.yaml) ---
# Registry the CI pushes to: ghcr.io/<github user, lowercase>. Log in once on the server:
#   echo <PAT with read:packages> | docker login ghcr.io -u <github user> --password-stdin
REGISTRY=
# Image tag to run: "main" for latest, or a git sha to pin / roll back
TAG=main
# Where the web container listens on the host. The host's nginx terminates TLS
# for your domain and proxies to this (deploy/nginx/monster.conf).
# Keep the bind on loopback: nginx is the only thing that should reach it.
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=8095
# Where creatures/ and monster.sqlite live on the server (back this folder up)
DATA_DIR=./data
# The containers run as this user, which must own DATA_DIR. `id -u` / `id -g`.
PUID=1000
PGID=1000

# --- api + cpu worker (defaults shown) ---
# Seconds before a job whose worker vanished is handed out again
MONSTER_LEASE_SECONDS=600
# Claims per job before it is marked failed
MONSTER_MAX_ATTEMPTS=3
MONSTER_MAX_UPLOAD_MB=25
# Shared secret for the GPU worker on the gaming PC (same value in both .env files).
# Empty = the GPU endpoints are off and AI 3D jobs just wait. Make one: openssl rand -hex 32
MONSTER_WORKER_TOKEN=

# --- gaming PC (compose.gpu.yaml) ---
# REGISTRY, TAG, PUID and PGID as above; MONSTER_WORKER_TOKEN as on the server.
# The home server's API as the PC reaches it (through the server's nginx, LAN-only)
MONSTER_SERVER=https://monster.example.com/api
# Model weights and compile caches (~16 GB). Must be owned by PUID.
CACHE_DIR=./cache
# Hugging Face token (read access). TRELLIS.2 uses Meta's DINOv3, a gated model: accept its
# licence at https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m first.
# Only needed for the first download; HF_HUB_OFFLINE=1 afterwards keeps it from phoning home.
HF_TOKEN=
# HF_HUB_OFFLINE=1
# Only run inside this window (empty = any time), optionally weekdays only
MONSTER_GPU_HOURS=
MONSTER_GPU_WEEKDAYS_ONLY=
# Someone is gaming when another process uses more VRAM than this (the desktop uses some)
MONSTER_MAX_OTHER_VRAM_MB=2048
# ... or when a process command line contains one of these
MONSTER_GAME_PATTERNS=steamapps/common/,wine64-preloader,wineserver,gamescope
# Seconds between asking the server for work
MONSTER_POLL_SECONDS=30
# 1 = no AI model: a flat card of the drawing. Tests the round trip before TRELLIS works.
MONSTER_GPU_PLACEHOLDER=
# TRELLIS.2: 512, 1024, 1024_cascade (default) or 1536_cascade. Out of memory falls back to 512.
MONSTER_TRELLIS_PIPELINE=1024_cascade
# 1 = keep models in RAM, each on the GPU only while it runs (small, slower). 0 = all on the
# GPU (faster if it fits; out of memory falls back to 1). The job log ends with the peak VRAM.
MONSTER_TRELLIS_LOW_VRAM=1
MONSTER_AI_FACES=150000
MONSTER_AI_TEXTURE=2048
# Turn the AI model around its vertical axis if it comes out facing away (degrees)
MONSTER_AI_YAW_DEG=0
